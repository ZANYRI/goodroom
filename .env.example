# Канонический HTTPS URL сайта
NEXT_PUBLIC_SITE_URL=https://goodroom26.ru

# Порт приложения на VPS (3002 — чтобы не конфликтовать с сайтами на 3000 и 3001)
PORT=3002

# Принудительный редирект с HTTP на HTTPS за прокси (Nginx)
ENFORCE_HTTPS=true

# ID счётчика Яндекс.Метрики (оригинальный счётчик с сайта Tilda)
NEXT_PUBLIC_YANDEX_METRIKA_ID=102654634

# Отправка заявок на бронирование и обратный звонок в Telegram-бота
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
